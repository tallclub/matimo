{
  "name": "matimo-repo",
  "private": true,
  "description": "Matimo monorepo — shared tooling (commitlint, husky)",
  "scripts": {
    "prepare": "husky install",
    "build": "pnpm --dir typescript build",
    "changelog": "git-cliff --config cliff.toml --output CHANGELOG.md && echo 'CHANGELOG.md generated ✨'",
    "changelog:preview": "git-cliff --config cliff.toml --unreleased | head -50"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7"
  }
}
