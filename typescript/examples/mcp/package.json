{
  "name": "matimo-mcp-examples",
  "version": "0.1.0-alpha.14",
  "description": "Matimo MCP examples - LangChain agents via stdio and Streamable HTTP",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "agent:stdio": "tsx src/agent-stdio.ts",
    "agent:http": "tsx src/agent-http.ts",
    "agent": "tsx src/agent.ts",
    "mcp:start": "matimo mcp",
    "mcp:start:http": "matimo mcp --transport http --port 3555"
  },
  "dependencies": {
    "@langchain/core": "^1.1.19",
    "@langchain/langgraph": "^1.1.4",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.2.5",
    "@matimo/cli": "workspace:*",
    "@matimo/core": "workspace:*",
    "@matimo/gmail": "workspace:*",
    "@matimo/slack": "workspace:*",
    "dotenv": "^16.4.0",
    "langchain": "^1.2.0",
    "matimo": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "better-sqlite3": "^12.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
