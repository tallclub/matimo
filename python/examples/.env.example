# ─────────────────────────────────────────────────────────────────────────────
# Matimo Python SDK Examples — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── OpenAI (required for LangChain agent examples) ───────────────────────────
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here


# ── Slack ─────────────────────────────────────────────────────────────────────
# Get your bot token from: https://api.slack.com/apps
# Required scopes: chat:write, channels:read, channels:history, reactions:write
# SLACK_BOT_TOKEN=xoxb-your-token-here
#
# Optional: provide a default channel ID for factory/decorator examples.
# Right-click a channel → Copy link → the ID is the last segment (e.g. C1234567890)
# SLACK_CHANNEL_ID=C1234567890


# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token from: https://github.com/settings/tokens
# Required scopes: repo, read:org  (read-only public access needs no scopes)
# GITHUB_TOKEN=ghp_your-pat-here


# ── Gmail ─────────────────────────────────────────────────────────────────────
# OAuth2 access token. Generate one at: https://developers.google.com/oauthplayground
# Scope: https://www.googleapis.com/auth/gmail.send
# GMAIL_ACCESS_TOKEN=ya29-your-token-here
#
# Email address used as sender / recipient in examples
# TEST_EMAIL=your@gmail.com


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# METHOD 1 — Connection string (recommended)
# MATIMO_POSTGRES_URL=postgresql://user:password@localhost:5432/mydatabase

# METHOD 2 — Separate variables
# MATIMO_POSTGRES_HOST=localhost
# MATIMO_POSTGRES_PORT=5432
# MATIMO_POSTGRES_USER=postgres
# MATIMO_POSTGRES_PASSWORD=password
# MATIMO_POSTGRES_DB=mydb


# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from: https://app.hubspot.com/private-apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
# MATIMO_HUBSPOT_API_KEY=pat-na1-your-key-here


# ── Notion ────────────────────────────────────────────────────────────────────
# Integration token from: https://www.notion.so/my-integrations
# Share your pages/databases with the integration after creating it.
# NOTION_API_KEY=secret_your-key-here
#
# Optional default database ID for examples (from the database URL)
# NOTION_DATABASE_ID=your-database-id-here


# ── Mailchimp ─────────────────────────────────────────────────────────────────
# API key from: https://mailchimp.com/help/about-api-keys/
# Format: <key>-<dc>  where dc is your data center (e.g. us1, us6)
# MAILCHIMP_API_KEY=your-key-here-us1


# ── Twilio ────────────────────────────────────────────────────────────────────
# Account SID and Auth Token from: https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token-here
# TWILIO_FROM_NUMBER=+15005550006
# TWILIO_TO_NUMBER=+1234567890

# ---- Microsoft Graph ───────────────────────────────────────────────────────────────
## Get a token from the Graph Explorer (sign in, consent to scopes, copy the
# "Access token" tab): https://developer.microsoft.com/en-us/graph/graph-explorer
# MICROSOFT_GRAPH_ACCESS_TOKEN=<your-access-token-here>
# TEST_DRIVE_ID=<your-drive-id-here>
# TEST_ITEM_ID=root
# TEST_TEAM_ID=<your-team-id-here>
# TEST_CHANNEL_ID=<your-channel-id-here>
# TEST_EMAIL=<your-email-here>

