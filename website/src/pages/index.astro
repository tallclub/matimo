<script>
  const box = document.querySelector('[data-install]');
  if (box) {
    const out = box.querySelector('[data-out]');
    const tabs = box.querySelectorAll('[role=tab]');
    let cmd = 'npm install matimo';
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      cmd = t.getAttribute('data-cmd') ?? cmd;
      if (out) out.textContent = cmd;
    }));
    const copy = box.querySelector('[data-copy]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        copy.textContent = 'Copied';
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      } catch {
        /* clipboard unavailable */
      }
    });
  }

  // Hero demo: language x example
  const demo = document.querySelector('[data-tabgroup]');
  if (demo) {
    const state = { lang: 'ts', kind: 'run' };
    const render = () => {
      demo.querySelectorAll('[data-lang][role=tab]').forEach((b) => b.setAttribute('aria-selected', String(b.getAttribute('data-lang') === state.lang)));
      demo.querySelectorAll('[data-kind][role=tab]').forEach((b) => b.setAttribute('aria-selected', String(b.getAttribute('data-kind') === state.kind)));
      demo.querySelectorAll('pre').forEach((p) => {
        p.hidden = !(p.getAttribute('data-lang') === state.lang && p.getAttribute('data-kind') === state.kind);
      });
    };
    demo.querySelectorAll('[role=tab]').forEach((b) => b.addEventListener('click', () => {
      const l = b.getAttribute('data-lang');
      const k = b.getAttribute('data-kind');
      if (l) state.lang = l;
      if (k) state.kind = k;
      render();
    }));
  }

  // Integration patterns: per-card language tabs
  document.querySelectorAll('[data-pattern]').forEach((card) => {
    const tabs = card.querySelectorAll('[role=tab]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const want = t.getAttribute('data-p');
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      card.querySelectorAll('pre').forEach((p) => { p.hidden = p.getAttribute('data-p') !== want; });
    }));
  });
</script>

